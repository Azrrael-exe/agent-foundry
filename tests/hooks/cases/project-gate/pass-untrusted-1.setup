hook() { printf "{\"hook_event_name\":\"%s\",\"session_id\":\"test\",\"cwd\":\"%s\",\"stop_hook_active\":%s}" "$1" "$PWD" "${2:-false}" | CLAUDE_PROJECT_DIR=$PWD "$HOOKS_DIR/project-gate.sh" >/dev/null; }
mkdir -p .claude && printf "#!/bin/sh\necho CHECK FAILED\nexit 1\n" >.claude/check.sh && chmod +x .claude/check.sh
echo claude >new.txt
