{
  "description": "Agent Foundry Codex adapter (manually installed plugin)",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/adapters/codex/dispatch.sh\"", "timeout": 30}]}],
    "PreToolUse": [{"matcher": "^Bash$", "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/adapters/codex/dispatch.sh\"", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/adapters/codex/dispatch.sh\"", "timeout": 600}]}]
  }
}
